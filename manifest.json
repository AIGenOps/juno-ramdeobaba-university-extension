{
  "manifest_version": 3,
  "name": "JUNO Helper (Feedback & Attendance Insights)",
  "version": "2.1.0",
  "description": "Feedback auto-pilot filler and Attendance Insights with bunk calculator for JUNO.",
  "content_scripts": [
    {
      "matches": [
        "*://*.rcoem.in/stu_instituteFeedbackStudent.htm*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.rcoem.in/studentCourseFileNew.htm*"
      ],
      "css": [
        "attendance.css"
      ],
      "js": [
        "attendance.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}